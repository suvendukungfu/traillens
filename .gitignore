# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage

# next.js & production builds
/.next/
/out/
/build
/dist

# misc OS files
.DS_Store
._*
.Spotlight-V100
.Trashes
*.pem

# debug & general logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables (whitelist .env.example)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE & editors
.vscode/
.idea/
*.swp
*.swo

# local scratch & temporary files
scratch/
tmp/
temp/

# model weight binaries (guard against accidental local model weight commits)
*.gguf
*.bin
*.safetensors
*.onnx
models/
